# Service
SERVICE_PORT=8014

# External services
ARTIFACT_SERVICE_URL=http://localhost:8011
WORKSPACE_SERVICE_URL=http://localhost:8010
KROKI_URL=http://kroki:8015

# Mongo
MONGODB_URI=mongodb+srv://sandeepk:sandeep@cluster0.tnbpi.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=RainaV2
# Collection name is defaulted in code: guidance_documents

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F

# LLM
LLM_PROVIDER=openai
LLM_MODEL_ID=gpt-4o-mini
LLM_TEMP=0.2
LLM_MAX_TOKENS=4000

# --- LLM keys (pick what you use) ---
OPENAI_API_KEY=<OPENAI_API_KEY>
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Filesystem (mount this path in Docker Compose to persist)
OUTPUT_DIR=/output
