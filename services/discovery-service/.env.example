# discovery-service/.env.example
MONGO_URI=mongodb+srv://sandeepk:sandeep@cluster0.tnbpi.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB=RainaV2

# Downstream services
CAPABILITY_REGISTRY_URL=http://localhost:8012
ARTIFACT_SERVICE_URL=http://localhost:8011

# Messaging
RABBITMQ_URI=amqp://raina:raina@localhost:5672/%2f
RABBITMQ_EXCHANGE=raina.events

# LLM
