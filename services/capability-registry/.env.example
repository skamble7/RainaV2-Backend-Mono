MONGO_URI=mongodb+srv://sandeepk:sandeep@cluster0.tnbpi.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB=RainaV2

# RabbitMQ
RABBITMQ_URI=amqp://raina:raina@rabbitmq:5672/
RABBITMQ_EXCHANGE=raina.events

# Artifact-service base URL used for kind validation
ARTIFACT_SERVICE_URL=http://artifact-service:8011

# Seeder behavior
CAPABILITIES_SEED_SKIP_IF_EXISTS=1           # skip seeding if collection already has data
CAPABILITIES_SEED_VALIDATE_KINDS=1           # warn if produces_kinds not registered in artifact-service
